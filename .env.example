# Copy this to .env.local for local development.
# On Render, add each of these under your service -> Environment.

# MongoDB Atlas connection string.
# In Atlas -> Network Access, allow 0.0.0.0/0 (Render has no fixed IP).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB=dtproject

# Long random string used to sign login tokens. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Groq API key for the AI chatbot
NEXT_GROQ_KEY=

# Optional: if set, people must enter this code to register as a vendor (shop owner)
VENDOR_SIGNUP_CODE=
